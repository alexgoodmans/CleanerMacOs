    },
    "%@ cache data." : {
      "comment" : "A description of the effect of removing the cache.",
      "isCommentAutoGenerated" : true
    },
    "%@ cached extension installers (.vsix). They can be re-downloaded." : {
      "comment" : "\"Usually safe\" here is a bit of a stretch, but it's not a critical issue. The argument is the string “Cursor” or the string “VS Code”.",
      "isCommentAutoGenerated" : true
    },
    "%@ code cache." : {
      "comment" : "The \"Cache\" bucket in the cursor scanner. The argument is the string “Cursor” or the string “VS Code”.",
      "isCommentAutoGenerated" : true
    },
    "%@ crash dumps." : {
      "comment" : "Crash dumps are files created by the Crashpad crash reporting system. The argument is the string “Cursor” or the string “VS Code”.",
      "isCommentAutoGenerated" : true
    },
    "%@ discarded extension installers. High-confidence cleanup — this is a trash folder for .vsix files." : {
      "comment" : "The trash folder is a special folder that is used to delete files. The argument is the string “Cursor” or the string “VS Code”.",
      "isCommentAutoGenerated" : true
    },
