    "%@ globalStorage holds extension databases, indexes and history. Not cache." : {
      "comment" : "\"User\" is a common macOS term for user-specific data, like saved passwords or browser history. The argument is the string “Cursor” or the string “VS Code”.",
      "isCommentAutoGenerated" : true
    },
